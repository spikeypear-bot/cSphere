-- DEV16: shared demo catalogue, explicitly authorised as an exception to fixture policy.
-- Generated by backend/dev/seed/generate_venues.py; source SHA-256: @SOURCE_HASH@
-- Self-contained: no external file, extension, application seeder or random UUIDs.
-- Once applied, never edit/regenerate this migration to change data.
-- Flyway runs this script transactionally on PostgreSQL. Lock both tables before
-- preflight so concurrent catalogue writes cannot race duplicate/collision checks.
LOCK TABLE venues, venue_operating_hours IN SHARE ROW EXCLUSIVE MODE;

CREATE TEMP TABLE dev16_seed_venues (LIKE venues INCLUDING CONSTRAINTS) ON COMMIT DROP;
ALTER TABLE dev16_seed_venues ADD PRIMARY KEY (venue_id);
INSERT INTO dev16_seed_venues
    (venue_id, venue_name, venue_address, venue_capacity, supported_layouts,
     venue_accessibilities, venue_facilities, setup_minutes, turnaround_minutes,
     operating_information, additional_information, latitude, longitude)
VALUES
@VENUES@;

CREATE TEMP TABLE dev16_seed_hours (
    operating_hour_id uuid PRIMARY KEY,
    venue_id uuid NOT NULL REFERENCES dev16_seed_venues(venue_id),
    day_of_week integer NOT NULL CHECK (day_of_week BETWEEN 1 AND 7),
    open_time time NOT NULL, close_time time NOT NULL CHECK (close_time > open_time),
    UNIQUE (venue_id, day_of_week)
) ON COMMIT DROP;
INSERT INTO dev16_seed_hours (operating_hour_id, venue_id, day_of_week, open_time, close_time)
VALUES
@HOURS@;

-- Match the room name AND full address, or a known deterministic UUID.
-- Legacy creation defaulted venue_name to venue_address: recognise that exact
-- address match too, but reject an unnamed record matching several seed rooms.
-- Normalise case/whitespace only. A shared address or coordinates alone must
-- never merge independently bookable rooms. No fuzzy identity inference.
CREATE TEMP TABLE dev16_seed_matches ON COMMIT DROP AS
SELECT s.venue_id AS seed_id, v.venue_id AS existing_id,
       lower(regexp_replace(btrim(v.venue_address), '[[:space:]]+', ' ', 'g')) =
       lower(regexp_replace(btrim(s.venue_address), '[[:space:]]+', ' ', 'g')) AS same_address,
       (lower(regexp_replace(btrim(v.venue_name), '[[:space:]]+', ' ', 'g')) =
        lower(regexp_replace(btrim(s.venue_name), '[[:space:]]+', ' ', 'g'))
        OR lower(regexp_replace(btrim(v.venue_name), '[[:space:]]+', ' ', 'g')) =
           lower(regexp_replace(btrim(v.venue_address), '[[:space:]]+', ' ', 'g'))) AS same_name
FROM dev16_seed_venues s JOIN venues v ON
    v.venue_id = s.venue_id
    OR (lower(regexp_replace(btrim(v.venue_address), '[[:space:]]+', ' ', 'g')) =
       lower(regexp_replace(btrim(s.venue_address), '[[:space:]]+', ' ', 'g'))
    AND (lower(regexp_replace(btrim(v.venue_name), '[[:space:]]+', ' ', 'g')) =
         lower(regexp_replace(btrim(s.venue_name), '[[:space:]]+', ' ', 'g'))
         OR lower(regexp_replace(btrim(v.venue_name), '[[:space:]]+', ' ', 'g')) =
            lower(regexp_replace(btrim(v.venue_address), '[[:space:]]+', ' ', 'g'))));

DO $$
DECLARE
    problems text;
    skipped integer;
    imported integer;
    rejected integer;
    detail record;
BEGIN
    SELECT string_agg(reason, E'\n' ORDER BY reason), count(DISTINCT seed_id)
    INTO problems, rejected FROM (
        SELECT m.seed_id, 'Venue identity/UUID conflict: seed ' || m.seed_id || ', existing ' || m.existing_id AS reason
        FROM dev16_seed_matches m WHERE NOT m.same_address OR NOT m.same_name
        UNION ALL
        SELECT seed_id, 'Ambiguous existing venues for seed ' || seed_id
        FROM dev16_seed_matches GROUP BY seed_id HAVING count(*) > 1
        UNION ALL
        SELECT m.seed_id, 'Existing venue matches multiple seed rooms: ' || m.existing_id
        FROM dev16_seed_matches m WHERE m.existing_id IN (
            SELECT existing_id FROM dev16_seed_matches GROUP BY existing_id HAVING count(DISTINCT seed_id) > 1
        )
        UNION ALL
        SELECT h.venue_id, 'Operating-hour UUID collision: ' || h.operating_hour_id
        FROM dev16_seed_hours h JOIN venue_operating_hours old USING (operating_hour_id)
        WHERE NOT EXISTS (SELECT 1 FROM dev16_seed_matches m WHERE m.seed_id = h.venue_id)
    ) conflicts;
    SELECT count(DISTINCT seed_id) INTO skipped FROM dev16_seed_matches;
    IF problems IS NOT NULL THEN
        RAISE EXCEPTION 'DEV16 seed aborted: imported=0, matched=%, rejected=%; all seed writes rolled back.% %',
            skipped, rejected, E'\n', problems;
    END IF;
    FOR detail IN SELECT * FROM dev16_seed_matches ORDER BY seed_id LOOP
        RAISE NOTICE 'DEV16 skipped seed %: existing venue % preserved with all user edits and operating hours',
            detail.seed_id, detail.existing_id;
    END LOOP;

    INSERT INTO venues SELECT s.* FROM dev16_seed_venues s
    WHERE NOT EXISTS (SELECT 1 FROM dev16_seed_matches m WHERE m.seed_id = s.venue_id);
    GET DIAGNOSTICS imported = ROW_COUNT;
    INSERT INTO venue_operating_hours (operating_hour_id, venue_id, day_of_week, open_time, close_time)
    SELECT h.operating_hour_id, h.venue_id, h.day_of_week, h.open_time, h.close_time
    FROM dev16_seed_hours h
    WHERE NOT EXISTS (SELECT 1 FROM dev16_seed_matches m WHERE m.seed_id = h.venue_id);
    RAISE NOTICE 'DEV16 seed complete: imported=%, skipped=%, rejected=0', imported, skipped;
END $$;
