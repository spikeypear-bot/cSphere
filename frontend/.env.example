# Copy this file to `.env.local` (git-ignored) to override defaults.
# See the README "Environment configuration" section for details.

# Base URL the API client prepends to every request path (src/lib/apiClient.ts).
# Leave unset to use the default "/api", which vite.config.ts proxies to the
# local backend in dev, and which a same-origin production deploy can serve
# directly. Only set this when the backend is on a different origin, e.g.:
# VITE_API_BASE_URL=https://api.connectsphere.example.com/api
